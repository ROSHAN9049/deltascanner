{
  "name": "dealdost-delta-india-scanner",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node --check server/tradetron.js && node --check worker/index.mjs && node --check worker/delta-adapter.mjs && node --check worker/engine.mjs && node --check worker/strategy.mjs && vite build",
