DELTA_ENVIRONMENT=SIGNAL_ONLY
# Direct execution is Testnet-only; live mode is rejected in server/config.js.
DELTA_EXECUTION_MODE=testnet # testnet | live (blocked) | disabled
DELTA_TESTNET_API_KEY=
DELTA_TESTNET_API_SECRET=
# Canonical dd_delta_positions IDs eligible for legacy automatic exits; empty = none.
EXIT_LIFECYCLE_ENROLLED_POSITION_IDS=
# Manual Options entry is separately gated; keep false until verified on Hostless.
OPTIONS_EXECUTION_ALLOWED=false
# Two independently protected Delta India Testnet Grid instruments; order routing remains off by default.
GRID_SYMBOLS=PAXGUSD,NVDAXUSD
GRID_EXECUTION_ALLOWED=false
# Automatically calculate Grid bounds from the previous completed UTC 1D candle; defaults off.
GRID_AUTO_RANGE_ENABLED=false
DELTA_TESTNET_REST_BASE=https://cdn-ind.testnet.deltaex.org
# Private WebSocket for authenticated orders/positions (not the public socket endpoint).
DELTA_TESTNET_WS_URL=wss://socket-ind.testnet.deltaex.org
ENGINE_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_ID=delta-worker-1
TRADETRON_BRIDGE_ENABLED=false
TRADETRON_DYNAMIC_BRIDGE_ENABLED=false
TRADETRON_BASE_URL=https://api.tradetron.tech
TRADETRON_AUTH_TOKEN=
TRADETRON_TIMEOUT_MS=10000
TRADETRON_CAPITAL_USD=5000

# Optional read-only Tradetron Developer API. Set the key only in the private worker environment.
# TRADETRON_DEVELOPER_API_KEY=
TRADETRON_DEVELOPER_API_BASE_URL=https://tradetron.tech/api/v1
TRADETRON_DEVELOPER_API_TIMEOUT_MS=8000

# Worker PostgreSQL maintenance. Retention deletes only public.dd_signals.
RETENTION_ENABLED=true
RETENTION_DAYS=1
RETENTION_BATCH_SIZE=5000
DISK_WARN_ROWS=250000
DISK_CRITICAL_ROWS=500000
RETENTION_OLD_ROWS_TRIGGER=50000

# Optional Telegram alerts for CONFIRMED, gate-passing MOMENTUM/SCALPING signals.
# Leave either value unset to silently disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hostless split deployment: private API App + public static Site.
# Set these on the Hostless API App (runtime), not on the Site.
# APP_ALLOWED_ORIGINS=https://<your-hostless-site-domain>
# Set this public build-time variable on the Hostless Site after the API App has a stable domain.
# VITE_API_BASE_URL=https://<your-hostless-api-app-domain>

# Adaptive Volatility Shadow requires this env flag AND the DB setting to be true.
# Shadow simulation only; it never submits Delta orders.
ADAPTIVE_VOLATILITY_SHADOW_ENABLED=false

# Regime-based Options require verified 15m/1h regime data and a Delta IV Rank value.
# Keep disabled until the schema migration is applied and the exchange payload includes iv_rank.
OPTIONS_REGIME_STRATEGY_ENABLED=false
# Automated exits run every 60 seconds; entries are blocked unless this is true.
OPTIONS_EXIT_MONITOR_ENABLED=false
# Separate daily Options realized-loss guard; implementation never permits a value above 2%.
OPTIONS_DAILY_LOSS_LIMIT_PCT=2
