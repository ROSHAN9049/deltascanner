DELTA_ENVIRONMENT=TESTNET
DELTA_TESTNET_API_KEY=
DELTA_TESTNET_API_SECRET=
ENGINE_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_ID=delta-worker-1
TRADETRON_BRIDGE_ENABLED=false
TRADETRON_DYNAMIC_BRIDGE_ENABLED=false
TRADETRON_BASE_URL=https://api.tradetron.tech
TRADETRON_AUTH_TOKEN=
TRADETRON_TIMEOUT_MS=10000
TRADETRON_CAPITAL_USD=5000

# Optional read-only Tradetron Developer API. Set the key only in Railway worker variables.
# TRADETRON_DEVELOPER_API_KEY=
TRADETRON_DEVELOPER_API_BASE_URL=https://tradetron.tech/api/v1
TRADETRON_DEVELOPER_API_TIMEOUT_MS=8000

# Worker PostgreSQL maintenance. Retention deletes only public.dd_signals.
RETENTION_ENABLED=true
RETENTION_DAYS=1
RETENTION_BATCH_SIZE=5000
DISK_WARN_ROWS=250000
DISK_CRITICAL_ROWS=500000
RETENTION_OLD_ROWS_TRIGGER=50000
